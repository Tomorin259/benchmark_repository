        "layers": {
          "gamma": "degradation_rate"
        }
      }
    },
    "Dynamo": {
      "source_generation": "labelled RPE1 kinetic result used to derive the historical alpha CSV",
      "rpe1": {
        "adapter": "dynamo_labelled_alpha",
        "result": "indicators/gene/scEU_rpe1_analyze/dynamo/dynamo_rpe1.h5ad",
